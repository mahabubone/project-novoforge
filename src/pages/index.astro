---
import Base from "../layouts/Base.astro";
---

<Base
  title="Novoforge — worldbuilding & novel-writing software"
  description="Write novels. Build worlds. Own everything. Local-first writing software with a distraction-free editor, relationship graphs, timelines, boards, revision history, and Scrivener-grade export. Free for individual authors."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Novoforge",
      operatingSystem: "Linux, Windows",
      applicationCategory: "WritingApplication",
      description:
        "Local-first worldbuilding and long-form writing software. Distraction-free editor, entity relationship graphs, timelines, boards, revision history, and Scrivener-grade compile & export.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "5",
        ratingCount: "1",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Novoforge features",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Manuscript editor with books, parts, chapters, scenes" },
        { "@type": "ListItem", position: 2, name: "Worldbuilding with typed entities and custom attributes" },
        { "@type": "ListItem", position: 3, name: "Relationship graph" },
        { "@type": "ListItem", position: 4, name: "Revision history and safety" },
        { "@type": "ListItem", position: 5, name: "Compile and export to DOCX, PDF, EPUB, HTML, Markdown, Shunn, Scrivener" },
        { "@type": "ListItem", position: 6, name: "Productivity: targets, stats, consistency checker" },
      ],
    },
  ]}
>
  <section class="hero">
    <img class="logo" src={import.meta.env.BASE_URL + "favicon.svg"} alt="Novoforge logo" width="96" height="96" />
    <h1>Write novels. Build worlds.&nbsp;Own everything.</h1>
    <p class="tagline">
      Local-first writing software with serious worldbuilding tools — a
      distraction-free editor, entity relationship graphs, timelines, boards,
      revision history, and Scrivener-grade compile &amp; export. All on-device.
      No accounts, no cloud, no lock-in.
    </p>
    <div class="buttons" role="group" aria-label="Download Novoforge">
      <a class="btn primary" href="https://github.com/mahabubone/project-novoforge/releases/latest">
        Download free for Linux
      </a>
      <a class="btn" href="https://github.com/mahabubone/project-novoforge/releases/latest">
        Download free for Windows
      </a>
    </div>
    <p class="platforms">Linux (AppImage · deb · rpm) · Windows (NSIS) · macOS coming later</p>
    <p class="free-note">
      <strong>Free for individual authors</strong> — personal, non-commercial use, forever.
    </p>
  </section>

  <section class="social-proof">
    <p>
      For writers who outgrew flat Markdown editors and refuse to rent their
      workflow from a subscription cloud. Your project is a folder on disk — a
      portable <code>.world</code> bundle containing your database, assets,
      revisions, and backups. Open it, back it up, sync it however you like.
    </p>
  </section>

  <section class="features" id="features" aria-labelledby="features-heading">
    <h2 id="features-heading" class="section-title">Features</h2>
    <div class="feature-grid">
      <div class="feature">
        <div class="icon" aria-hidden="true">✒️</div>
        <h3>Manuscript</h3>
        <p>
          Books, parts, chapters and scenes with a distraction-free editor, focus
          mode, typewriter scrolling, scrivenings view and per-scene word targets.
          Corkboard and outliner views, project-wide find &amp; replace, and a
          ⌘K command palette.
        </p>
      </div>
      <div class="feature">
        <div class="icon" aria-hidden="true">🌍</div>
        <h3>Worldbuilding</h3>
        <p>
          Typed entities — characters, locations, factions, items, creatures —
          with custom attributes, tags, relationship graphs, timelines, calendars
          and family trees. Track everything that matters in your world.
        </p>
      </div>
      <div class="feature">
        <div class="icon" aria-hidden="true">📊</div>
        <h3>Relationship graph</h3>
        <p>
          Visualize connections between characters, places and factions. Filter by
          relationship type, trace alliances and rivalries across your story.
        </p>
      </div>
      <div class="feature">
        <div class="icon" aria-hidden="true">📜</div>
        <h3>History &amp; safety</h3>
        <p>
          Revision snapshots with diff viewing and restore, rolling auto-backup on
          close, and scheduled encrypted archives to a local folder, Dropbox or S3.
        </p>
      </div>
      <div class="feature">
        <div class="icon" aria-hidden="true">📦</div>
        <h3>Compile &amp; export</h3>
        <p>
          Reusable Scrivener-style compile formats targeting DOCX, PDF, EPUB, HTML,
          Markdown, Shunn manuscripts and Scrivener bundles — checksummed exports,
          with matching imports back in.
        </p>
      </div>
      <div class="feature">
        <div class="icon" aria-hidden="true">🎯</div>
        <h3>Productivity</h3>
        <p>
          Writing targets, a stats dashboard (words/day, streaks, chapter
          lengths), readability stats, a consistency checker, series tracking,
          project templates and name generation.
        </p>
      </div>
    </div>
  </section>

  <section class="also" aria-labelledby="also-heading">
    <h2 id="also-heading" class="visually-hidden">Also included</h2>
    <p>
      <strong>Also in the box:</strong> native desktop menus with About / Keyboard
      Shortcuts / What's New · dark &amp; light themes · recent projects with
      auto-open · automatic updates from GitHub Releases.
    </p>
  </section>

  <section class="screens" aria-labelledby="screens-heading">
    <h2 id="screens-heading" class="section-title">See it in action</h2>
    <div class="gallery">
      <figure>
        <img src={import.meta.env.BASE_URL + "screens/manuscript.png"} alt="Novoforge manuscript editor showing an open scene with outline, scrivenings and per-scene word targets" loading="lazy" />
        <figcaption>Manuscript — outline, editor and inspector</figcaption>
      </figure>
      <figure>
        <img src={import.meta.env.BASE_URL + "screens/world.png"} alt="Novoforge worldbuilding entity editor with typed characters, locations and custom attributes" loading="lazy" />
        <figcaption>Worldbuilding — typed entities and custom attributes</figcaption>
      </figure>
      <figure>
        <img src={import.meta.env.BASE_URL + "screens/graph.png"} alt="Novoforge relationship graph visualizing connections between characters and locations" loading="lazy" />
        <figcaption>Relationship graph</figcaption>
      </figure>
      <figure>
        <img src={import.meta.env.BASE_URL + "screens/stats.png"} alt="Novoforge writing stats dashboard with words per day, streaks and targets" loading="lazy" />
        <figcaption>Stats — words per day, streaks and targets</figcaption>
      </figure>
      <figure>
        <img src={import.meta.env.BASE_URL + "screens/boards.png"} alt="Novoforge planning boards for organizing scenes and chapters" loading="lazy" />
        <figcaption>Boards — plan scenes and chapters</figcaption>
      </figure>
      <figure>
        <img src={import.meta.env.BASE_URL + "screens/backups.png"} alt="Novoforge backup settings with local and Dropbox encrypted archive options" loading="lazy" />
        <figcaption>Backups — local or Dropbox, encrypted</figcaption>
      </figure>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-heading">
    <h2 id="cta-heading">Ready to write?</h2>
    <p>Download the latest release. Free for individual authors.</p>
    <div class="buttons" role="group" aria-label="Download Novoforge">
      <a class="btn primary" href="https://github.com/mahabubone/project-novoforge/releases/latest">
        Download Novoforge
      </a>
      <a class="btn" href={import.meta.env.BASE_URL + "install/"}>Install guide</a>
    </div>
  </section>
</Base>
