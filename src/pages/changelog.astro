---
import Base from "../layouts/Base.astro";
import changelog from "../data/changelog.json";
---

<Base
  title="Changelog — Novoforge"
  description="What's new in each Novoforge release. Version history with new features, improvements, and fixes — from v0.1.0 through v1.0.3."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Novoforge Changelog",
      description: "Version history of Novoforge — local-first worldbuilding and novel-writing software.",
      url: "https://mahabubone.github.io/project-novoforge/changelog/",
    },
  ]}
>
  <section class="changelog">
    <header class="changelog-head">
      <h1>Changelog</h1>
      <p>What's new in each release, built from the project's commit history.</p>
    </header>

    {
      changelog.map((v) => (
        <article class="version-block" aria-labelledby={`v-${v.version}`}>
          <div class="version-head">
            <span class="version-badge" id={`v-${v.version}`}>{v.version}</span>
            <time dateTime={v.date}>{v.date}</time>
          </div>

          {v.features.length > 0 && (
            <div class="entry-group">
              <h3 class="entry-title new">New</h3>
              <ul>
                {v.features.map((f) => (
                  <li set:html={f} />
                ))}
              </ul>
            </div>
          )}

          {v.improvements.length > 0 && (
            <div class="entry-group">
              <h3 class="entry-title improved">Improved</h3>
              <ul>
                {v.improvements.map((f) => (
                  <li set:html={f} />
                ))}
              </ul>
            </div>
          )}

          {v.fixes.length > 0 && (
            <div class="entry-group">
              <h3 class="entry-title fixed">Fixed</h3>
              <ul>
                {v.fixes.map((f) => (
                  <li set:html={f} />
                ))}
              </ul>
            </div>
          )}

          {v.features.length === 0 && v.fixes.length === 0 && v.improvements.length === 0 && (
            <p class="empty">Maintenance release.</p>
          )}
        </article>
      ))
    }
  </section>
</Base>
