---
import "../styles/global.css";

interface Props {
  title?: string;
  docs?: boolean;
}

const { title = "Novoforge", docs = false } = Astro.props.frontmatter ?? Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Novoforge — local-first worldbuilding and long-form writing software. Write novels, build worlds, own your work. Free for individual authors."
    />
    <meta property="og:title" content="Novoforge — worldbuilding & novel-writing software" />
    <meta property="og:description" content="Write novels. Build worlds. Own everything. Local-first writing software with serious worldbuilding tools. Free for individual authors." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mahabubone.github.io/project-novoforge/" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="brand" href={`${base}`}>
          <img src={`${base}favicon.svg`} alt="" />
          Novoforge
        </a>
        <nav class="site">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}changelog/`}>Changelog</a>
          <a href={`${base}install/`}>Install</a>
          <a href={`${base}license/`}>License</a>
          <a class="nav-download" href="https://github.com/mahabubone/project-novoforge/releases/latest">Downloads</a>
        </nav>
      </div>
    </header>
    <main>
      {docs ? (
        <article class="docs">
          <slot />
        </article>
      ) : (
        <slot />
      )}
    </main>
    <footer class="site">
      <div class="inner">
        <span>© 2026 Mahabub · github.com/mahabubone</span>
        <span>
          Free for personal, non-commercial use by individuals ·
          <a href={`${base}license/`}>see license</a>
        </span>
      </div>
    </footer>
  </body>
</html>
