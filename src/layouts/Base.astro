---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  docs?: boolean;
  jsonLd?: object | object[];
}

const { title = "Novoforge", docs = false } = Astro.props.frontmatter ?? Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = "https://mahabubone.github.io/project-novoforge";

const desc =
  Astro.props.description ??
  "Novoforge — local-first worldbuilding and long-form writing software. Write novels, build worlds, own your work. Free for individual authors.";

const ogImage = Astro.props.image ?? `${siteUrl}/og-image.png`;
const pageType = Astro.props.type ?? "website";
const canonical = `https://mahabubone.github.io${Astro.url.pathname.replace(/\/$/, "") || "/"}`;

// JSON-LD: accept per-page structured data, always include the site-level WebApplication
const pageJsonLd = Astro.props.jsonLd ?? [];
const scripts = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Novoforge",
    url: siteUrl,
    description: desc,
    applicationCategory: "WritingApplication",
    operatingSystem: "Linux, Windows",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    author: {
      "@type": "Person",
      name: "Mahabub",
      url: "https://github.com/mahabubone",
    },
  },
  ...(Array.isArray(pageJsonLd) ? pageJsonLd : [pageJsonLd]),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content="novoforge,novel writing software,worldbuilding,writing app,local-first,offline writing,scrivener alternative,book writing,character development,plotting,writing tools,free writing software,markdown export,epub export,docx export,writing community,author tools,fiction writing,long-form writing,writing productivity,writing app linux,writing app windows,writing app desktop,writing software free,writing app open source,writing app privacy,writing app offline,writing app local-first,writing app no subscription,writing app no cloud,writing app no account,writing app portable,writing app sqlite,writing app electron,writing app react,writing app typescript" />
    <meta name="author" content="Mahabub" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#09090b" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Novoforge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Novoforge — worldbuilding & novel-writing software" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mahabubone" />
    <meta name="twitter:creator" content="@mahabubone" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Novoforge — worldbuilding & novel-writing software" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}favicon.svg`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured data -->
    {scripts.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <header class="site" role="banner">
      <div class="inner">
        <a class="brand" href={`${base}`} aria-label="Novoforge home">
          <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
          Novoforge
        </a>
        <nav class="site" role="navigation" aria-label="Primary">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}install/`}>Install</a>
          <a href={`${base}changelog/`}>Changelog</a>
          <a href={`${base}license/`}>License</a>
          <a class="nav-download" href="https://github.com/mahabubone/project-novoforge/releases/latest">Downloads</a>
        </nav>
      </div>
    </header>
    <main role="main">
      {docs ? (
        <article class="docs">
          <slot />
        </article>
      ) : (
        <slot />
      )}
    </main>
    <footer class="site" role="contentinfo">
      <div class="inner">
        <span>© 2026 Mahabub · github.com/mahabubone</span>
        <span>
          Free for personal, non-commercial use by individuals ·
          <a href={`${base}license/`}>see license</a>
        </span>
      </div>
    </footer>
  </body>
</html>
