---
import "../styles/global.css";

interface Props {
  title?: string;
  docs?: boolean;
}

const { title = "Novoforge", docs = false } = Astro.props.frontmatter ?? Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Novoforge — local-first worldbuilding and long-form writing software. Your project is a folder on disk. Free for personal use."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="brand" href={`${base}`}>
          <img src={`${base}favicon.svg`} alt="" />
          Novoforge
        </a>
        <nav class="site">
          <a href={`${base}install/`}>Install</a>
          <a href={`${base}license/`}>License</a>
          <a href="https://github.com/mahabubone/project-novoforge/releases/latest"
            >Downloads</a
          >
        </nav>
      </div>
    </header>
    <main>
      {docs ? (
        <article class="docs">
          <slot />
        </article>
      ) : (
        <slot />
      )}
    </main>
    <footer class="site">
      <div class="inner">
        <span>© 2026 Mahabub · github.com/mahabubone</span>
        <span>
          Free for personal, non-commercial use by individuals ·
          <a href={`${base}license/`}>see license</a>
        </span>
      </div>
    </footer>
  </body>
</html>